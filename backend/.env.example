# GrowSphere Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# --- Database ---
DATABASE_URL=postgresql://growsphere:growsphere_dev@localhost:5432/growsphere

# --- Auth ---
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
APP_NAME=GrowSphere
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- File Storage (Phase 2 — S3-compatible) ---
# STORAGE_BUCKET=growsphere-uploads
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_KEY=
# STORAGE_SECRET=

# --- Payment Gateway (Phase 2) ---
# PAYMENT_GATEWAY_KEY=
# PAYMENT_GATEWAY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
