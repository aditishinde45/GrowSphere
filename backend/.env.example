# GrowSphere Environment Configuration

# --- App ---
APP_NAME=GrowSphere
APP_ENV=development
DEBUG=True

# --- Production Database (PostgreSQL) ---
POSTGRES_USER=growsphere
POSTGRES_PASSWORD=growsphere_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=growsphere_prod
# In production, set DATABASE_URL=postgresql://growsphere:growsphere_secure_pass@localhost:5432/growsphere_prod

# --- Development Database (SQLite) ---
# Default for local testing without external database server:
DATABASE_URL=sqlite:///./growsphere_dev.db

# --- Security & JWT ---
SECRET_KEY=growsphere_jwt_secret_key_development_32bytes_long_min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
